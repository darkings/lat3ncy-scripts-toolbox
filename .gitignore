.worktrees/
__pycache__/
*.py[cod]
# hidapi 扩展模块需要入库，换机免 pip。
!/tools/rgb/lib_hid/*.pyd
*.lnk
*.bak

# 根 README 与模块 README 入库；其余 markdown 默认忽略。
**/*.md
!/README.md
!/tools/*/README.md
!/resources/cursors/README.md
!/findings.md
!/progress.md
!/task_plan.md
/docs/

# 运行日志（含 DSH 轮转后的 watcher.log.1）
**/*.log
**/*.log.1
/tools/rgb/logs/
/tools/dsh-remote/*.log
/tools/tts/*.log
/tools/theme-scheduler/*.log

/tools/raycast-scripts/ocr/*.png
/tools/raycast-scripts/ocr/models/*.onnx

# 调试产物、临时下载与手动 pip 解压目录，不进仓库。
.tmp/
.pip_manual/
.tmp_caps/
/test_*.ahk
/test.txt
/*.png

# RGB：OpenRGB / PawnIO 由系统安装，不进仓库。
# PyInstaller 产物忽略，但本机 Ambient 仍依赖 dist/hi75/hi75.exe，不要误删。
/tools/rgb/OpenRGB-App/
/tools/rgb/PawnIO_setup.exe
/tools/rgb/build/
/tools/rgb/dist/

# WinUI IME HUD：源码入库；bin/obj/out 与调试符号忽略。
/tools/ime-hud-winui/bin/
/tools/ime-hud-winui/obj/
/tools/ime-hud-winui/out/
/tools/ime-hud-winui/*.pdb
