#Requires AutoHotkey v2.0

class Shortcuts {
    static CapsLockIme := "$CapsLock"
    static AlwaysOnTop := "^#t"
    static SearchSelectedText := "^+g"
    static SmartPaste := "^+v"
    static OpenSelectedTarget := "^!o"
    static LocateSelectedTarget := "^!e"
    static ToggleHiddenFiles := "#+."
}
