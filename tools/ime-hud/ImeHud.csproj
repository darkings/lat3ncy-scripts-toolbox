<Project Sdk="Microsoft.NET.Sdk">
  <!--
    IME 状态 HUD：独立 WinExe。AHK 只负责热键和 IME 检测，本进程只负责显示。

    不用 WinUI 3 的原因：本机没有 Windows App SDK 工作负载 / WinUI 模板，
    unpackaged WinUI 的 NoActivate popup 也不稳。视觉层改用 WPF HwndSource
    + DWM Desktop Acrylic（DWMSBT_TRANSIENTWINDOW），窗口行为仍按候选框做：
    WS_POPUP / WS_EX_NOACTIVATE / 小圆角 / 系统阴影 / PerMonitorV2。
    对外协议不变，以后可以整段替换渲染实现。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Lat3ncyToolbox.ImeHud</RootNamespace>
    <AssemblyName>ImeHud</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Description>Lat3ncy IME status HUD</Description>
    <LangVersion>latest</LangVersion>
    <ForceDesignerDpiUnaware>false</ForceDesignerDpiUnaware>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>
  <!--
    UIA 由 UseWPF 自带的 WindowsDesktop 框架提供，不要再写 <Reference>：
    那会去项目目录找 DLL，触发 MSB3245/MSB3243。
  -->
</Project>
